{
	"name": "famie-frontend",
	"description": "Frontend for the Famie project",
	"version": "0.5.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt generate",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "nuxi typecheck",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install chromium webkit",
		"test:unit": "node --test tests/unit/*.test.ts"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"nuxt": "^4.5.2",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@vite-pwa/nuxt": "^1.1.1",
		"typescript": "^5.7.0",
		"vue-tsc": "^2.2.0"
	}
}
