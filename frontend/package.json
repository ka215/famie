{
	"name": "famie-frontend",
	"description": "Frontend for the Famie project",
	"version": "0.19.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "pnpm i18n:generate && nuxt generate",
		"dev": "nuxt dev",
		"generate": "pnpm i18n:generate && nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "nuxi typecheck",
		"test:e2e": "playwright test",
		"test:release": "playwright test --config playwright.release.config.ts",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install chromium webkit",
		"test:unit": "node --test tests/unit/*.test.ts",
		"test:api": "redocly lint ../docs/api/openapi.yaml --extends spec && node ../scripts/check-api-contract.mjs",
		"i18n:generate": "node scripts/i18n.mjs --write",
		"i18n:check": "node scripts/i18n.mjs"
	},
	"dependencies": {
		"@nuxtjs/i18n": "10.6.0",
		"@tailwindcss/vite": "^4.3.3",
		"libheif-js": "^1.23.5",
		"nuxt": "^4.6.2",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@redocly/cli": "2.64.0",
		"@vite-pwa/nuxt": "^1.1.1",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"typescript": "^5.7.0",
		"vue-tsc": "^2.2.0"
	}
}
