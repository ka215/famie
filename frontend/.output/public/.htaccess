Options -MultiViews
RewriteEngine On

# BEGIN FAMIE MAINTENANCE
ErrorDocument 503 /maintenance.html
<If "%{REQUEST_URI} =~ m#^/api(?:/|$)#">
    ErrorDocument 503 /maintenance.json
</If>
Header always set Cache-Control "no-store, max-age=0" "expr=%{REQUEST_STATUS} == 503"
Header always set Retry-After "60" "expr=%{REQUEST_STATUS} == 503"
<FilesMatch "^maintenance\.(html|json)$">
    Header always set Cache-Control "no-store, max-age=0"
</FilesMatch>
# mod_alias applies even when the API has its own mod_rewrite rules.
<If "-f '%{DOCUMENT_ROOT}/.maintenance' && %{REQUEST_URI} !~ m#^/maintenance\.(html|json)$#">
    Redirect 503 /
</If>
# END FAMIE MAINTENANCE

# API は上位の Apache 設定または Laravel 側のルールへ渡す。
RewriteCond %{REQUEST_URI} ^/api(?:/|$) [NC]
RewriteRule ^ - [L]

# 実在する静的ファイルとディレクトリはそのまま配信する。
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Vue Router の画面 URL を SPA のエントリーポイントへ戻す。
RewriteRule ^ index.html [L]
